                                    <children>
                                        <!-- TABLE ID FIXED TO tblAllPolicies -->
                                        <TableView fx:id="tblAllPolicies" prefHeight="240.0" prefWidth="1070.0">
                                            <columns>
                                                <!-- COLUMN IDs FIXED -->
                                                <TableColumn fx:id="colPolNum" prefWidth="90" text="Policy No." />
                                                <TableColumn fx:id="colPolReg" prefWidth="90" text="Reg. No." />
                                                <TableColumn fx:id="colPolOwner" prefWidth="120" text="Owner" />
                                                <TableColumn fx:id="colPolMakeModel" prefWidth="120" text="Make/Model" /> <!-- No ID needed if not bound in AdminInsurance -->
                                                <TableColumn fx:id="colPolType" prefWidth="110" text="Type" />
                                                <TableColumn fx:id="colPolInsurer" prefWidth="100" text="Provider" />
                                                <TableColumn fx:id="colPolStart" prefWidth="90.0" text="Start Date" />
                                                <TableColumn fx:id="colPolExpiry" prefWidth="140.0" text="Expiry Date" />
                                                <TableColumn fx:id="colPolPremium" prefWidth="98.0" text="Premium (M)" />
                                                <TableColumn fx:id="colPolStatus" prefWidth="111.0" text="Status" />

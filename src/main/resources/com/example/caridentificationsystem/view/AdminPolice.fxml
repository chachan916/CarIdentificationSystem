                <HBox prefHeight="90.0" prefWidth="1090.0" spacing="15.0">
                    <children>
                        <Pane prefHeight="90.0" prefWidth="260.0" style="-fx-background-color: white; -fx-background-radius: 12;">
                            <children>
                                <Label layoutX="15.0" layoutY="15.0" text="Total Reports" textFill="#777"><font><Font name="System Bold" size="14.0" /></font></Label>
                                <Label fx:id="lblTotalReports" layoutX="15.0" layoutY="35.0" text="0" textFill="#333"><font><Font name="System Bold" size="28.0" /></font></Label>
                            </children>
                        </Pane>
                        <Pane prefHeight="90.0" prefWidth="260.0" style="-fx-background-color: white; -fx-background-radius: 12;">
                            <children>
                                <Label layoutX="15.0" layoutY="15.0" text="Active Cases" textFill="#777"><font><Font name="System Bold" size="14.0" /></font></Label>
                                <Label fx:id="lblActiveCases" layoutX="15.0" layoutY="35.0" text="0" textFill="#eb5757"><font><Font name="System Bold" size="28.0" /></font></Label>
                            </children>
                        </Pane>
                        <Pane prefHeight="90.0" prefWidth="260.0" style="-fx-background-color: white; -fx-background-radius: 12;">
                            <children>
                                <Label layoutX="15.0" layoutY="15.0" text="Flagged Vehicles" textFill="#777"><font><Font name="System Bold" size="14.0" /></font></Label>
                                <Label fx:id="lblFlaggedTotal" layoutX="15.0" layoutY="35.0" text="0" textFill="#f2994a"><font><Font name="System Bold" size="28.0" /></font></Label>
                            </children>
                        </Pane>
                    </children>
                </HBox>

                <!-- TABBED VIEW -->
                <TabPane prefHeight="330.0" prefWidth="1090.0" style="-fx-background-color: white; -fx-background-radius: 12;" tabClosingPolicy="UNAVAILABLE">
                    <tabs>
                        <Tab text="Police Reports">
                            <content>
                                <VBox spacing="10.0" style="-fx-padding: 10;">
                                    <children>
                                        <TableView fx:id="reportTable" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colReg" prefWidth="90" text="Reg No" />
                                                <TableColumn fx:id="colOwner" prefWidth="120" text="Owner" />
                                                <TableColumn fx:id="colType" prefWidth="100" text="Type" />
                                                <TableColumn fx:id="colDate" prefWidth="90" text="Date" />
                                                <TableColumn fx:id="colOfficer1" prefWidth="120" text="Officer" />
                                            </columns>
                                        </TableView>
                                    </children>
                                </VBox>
                            </content>
                        </Tab>

                        <Tab text="Flagged Vehicles">
                            <content>
                                <HBox spacing="15.0" style="-fx-padding: 15;">
                                    <children>
                                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                                    <children>
                                                        <ProgressIndicator fx:id="indInvestigation" prefHeight="25.0" prefWidth="25.0" />
                                                    </children>
                                                </HBox>
                                                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                                                    <content>
                                                        <TableView fx:id="tblFlagged" prefHeight="253.0" prefWidth="1045.0">
                                                            <columns>
                                                                <TableColumn fx:id="colFlagReg" prefWidth="100" text="Reg Number" />
                                                                <TableColumn fx:id="colMake" prefWidth="130" text="Make" />
                                                                <TableColumn fx:id="colModel" prefWidth="140" text="Model" />
                                                                <TableColumn fx:id="colYear" prefWidth="90" text="Year" />
                                                                <TableColumn fx:id="colColour" prefWidth="90" text="Colour" />
                                                                <TableColumn fx:id="colOwnerNames" prefWidth="110" text="Owner Names" />
                                                                <TableColumn fx:id="colFlagType" prefWidth="155.0" text="Flag Type" />
                                                                <TableColumn fx:id="colVehicleStatus" prefWidth="121.0" text="Vehicle Status" />
                                                                <TableColumn fx:id="colOfficer" prefWidth="108.0" text="Officer" />
                                                            </columns>
                                                        </TableView>
                                                    </content>
                                                </ScrollPane>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>

                <!-- BOTTOM ROW -->
                <HBox prefHeight="170.0" prefWidth="1090.0" spacing="15.0">
                    <children>
                        <VBox prefWidth="1090.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15;">
                            <children>
                                <Label text="Flagged Vehicles (Active Alerts Summary)"><font><Font name="System Bold" size="15.0" /></font></Label>
                                <ListView fx:id="flaggedList" prefHeight="120.0" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: #eee; -fx-border-radius: 5;" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>